OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
TAVILY_API_KEY=tvly-your-tavily-key

# Defaults (override as needed)
DEFAULT_MODEL_PROVIDER=openai
DEFAULT_MODEL_NAME=gpt-4o

# Local dev default (file-based, not suitable for serverless deploys):
DATABASE_URL=sqlite+aiosqlite:///./data/platform.db

# Production (e.g. Vercel): use a hosted Postgres database instead, since
# serverless functions don't persist a local filesystem across invocations.
# DATABASE_URL=postgresql+asyncpg://user:password@host/dbname
